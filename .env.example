# Copia este archivo como .env.local para desarrollo. Nunca subas valores reales al repositorio.

# Modo de la aplicación: «demo» (por defecto, sin backend) o «registro» (requiere backend configurado).
VITE_APP_MODE=demo

# Ruta base para GitHub Pages, p. ej. /salvaguardaprotecci-n/ (en local, /).
VITE_BASE_PATH=/

# Solo para modo registro. URL del proyecto y clave PÚBLICA del proveedor (publishable/anon).
# Nunca pongas aquí una clave secreta o service_role: el frontend es público.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para pruebas locales no productivas del modo registro con el aviso de privacidad incompleto.
# ALLOW_INCOMPLETE_REGISTRO=1
